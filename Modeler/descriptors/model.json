        {
          "name": "frequency",
          "isAttr": true,
          "type": "Integer"
        },
        {
          "name": "userWithoutRole",
          "isAttr": false,
          "isMany": true,
          "type": "String"
        },
        {
          "name": "userWithRole",
          "isAttr": false,
          "isMany": true,
          "type": "KeyValuePair",
