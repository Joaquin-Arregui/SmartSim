          },
          "xml": { "serialize": "property-as-element" }
        },
        {
          "name": "deleteUser",
          "isAttr": false,
          "isMany": true,
          "type": "KeyValuePairDeleteUser",
          "xml": {
            "serialize": { "element": "deleteUser" },
            "deserialize": { "element": "deleteUser" }
          },
          "xml": { "serialize": "property-as-element" }
        }
      ]
    },
    {
      "name": "KeyValuePairAddUser",
      "properties": [
        {
          "name": "key",
          "type": "String"
        },
        {
          "name": "value",
          "type": "String"
        }
      ]
    },
    {
      "name": "KeyValuePair",
      "properties": [
        {
          "name": "key",
          "type": "String"
        },
        {
          "name": "value",
          "type": "String"
        }
      ]
    },
    {
      "name": "KeyValuePairDeleteUser",
      "properties": [
        {
          "name": "key",
          "type": "String"
        },
        {
          "name": "value",
          "type": "String"
        }
      ]
    }
  ]
